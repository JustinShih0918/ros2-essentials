            custom uint64 outputs:context
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (135, 306)
        }

        def OmniGraphNode "ros2_qos_profile" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:createProfile (
                allowedTokens = ["Default for publishers/subscribers", "Services", "Sensor Data", "System Default", "Custom"]
            )
            custom double inputs:deadline
            custom uint64 inputs:depth
            custom token inputs:durability (
                allowedTokens = ["systemDefault", "transientLocal", "volatile", "unknown"]
            )
            custom token inputs:history (
                allowedTokens = ["systemDefault", "keepLast", "keepAll", "unknown"]
            )
            custom double inputs:leaseDuration
            custom double inputs:lifespan
            custom token inputs:liveliness (
                allowedTokens = ["systemDefault", "automatic", "manualByTopic", "unknown"]
            )
            custom token inputs:reliability (
                allowedTokens = ["systemDefault", "reliable", "bestEffort", "unknown"]
            )
            token node:type = "isaacsim.ros2.bridge.ROS2QoSProfile"
            int node:typeVersion = 1
            custom string outputs:qosProfile
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (423, -91)
        }
    }
}

